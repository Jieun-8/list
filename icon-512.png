#verse-related-search[hidden] { display: none !important; }
.verse-related-search {
  max-width: 560px;
  margin: 0 auto 30px;
  padding: 0 16px;
  text-align: center;
  color: var(--muted, #827587);
}
.verse-related-search p {
  margin: 0 0 14px;
  font-size: 13px;
  line-height: 1.9;
}
.verse-related-search button {
  max-width: 100%;
  padding: 11px 18px;
  border: 1px solid var(--line, #e4dfe9);
  border-radius: 999px;
  background: #fff;
  color: var(--accent, #637eac);
  font: inherit;
  font-size: 13px;
  line-height: 1.6;
  cursor: pointer;
  overflow-wrap: anywhere;
}
.verse-related-search button:focus-visible {
  outline: 2px solid var(--accent, #637eac);
  outline-offset: 3px;
}
.verse-related-search small {
  display: block;
  margin-top: 11px;
  font-size: 11px;
  line-height: 1.8;
}
